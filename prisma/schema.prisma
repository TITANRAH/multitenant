// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Fundaciones multi-tenant (Sprint 1) ---
// Ver docs/plan.md secciones 1, 2 y 7.

model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  host String @unique

  nombre String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config      TenantConfig?
  features    TenantFeature[]
  users       User[]
  invitations Invitation[]

  @@map("tenants")
}

// Identidad visual y datos de contacto del taller (Sprint 10 los edita,
// pero el modelo vive desde el Sprint 1 porque el PDF del Sprint 4 ya los usa).
model TenantConfig {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl         String?
  colorPrimario   String?
  colorSecundario String?
  tipografia      String?

  direccion String?
  ciudad    String?
  telefono  String?
  correo    String?
  instagram String?
  rubro     String?

  // Contador vivo de OT/mantenciones (Sprint 3 lo lee e incrementa en cada
  // OT nueva). Se siembra en el alta con el número donde el taller se
  // quedó en su sistema anterior — nunca reinicia en 1 un taller con
  // historial previo.
  correlativoActual Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_configs")
}

// Activación de features por taller. El catálogo vive en código
// (src/features/registry.ts), esta tabla solo enciende/apaga y parametriza.
model TenantFeature {
  tenantId   String
  featureKey String

  enabled   Boolean   @default(true)
  config    Json?
  expiresAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureKey])
  @@map("tenant_features")
}

// Rol operativo dentro de un taller. Ver assertRole (Sprint 2).
enum StaffRole {
  OWNER
  ADMIN
  RECEPCION
  MECANICO
}

// Rol de plataforma (tu cuenta), independiente del rol dentro del taller.
// Nulo para el staff normal de un taller; solo se usa para el panel de
// plataforma, servido por el tenant especial de slug "plataforma".
enum PlatformRole {
  SUPERADMIN
}

model User {
  id       String @id @default(cuid())
  tenantId String

  email        String
  name         String
  passwordHash String? // null hasta que la invitación se acepta y define contraseña

  role         StaffRole
  platformRole PlatformRole?

  // Bloqueo optimista genérico (regla Sprint 2): se incrementa en cada
  // update; un update con version desactualizada falla en vez de pisar
  // el cambio de otro usuario. Ver src/lib/db/optimistic.ts.
  version Int @default(1)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Invitación pendiente: el OWNER/ADMIN la crea, se manda por email (Resend),
// la persona la acepta y ahí recién se crea/activa su User con passwordHash.
model Invitation {
  id       String @id @default(cuid())
  tenantId String

  email String
  role  StaffRole
  token String    @unique

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id])

  expiresAt  DateTime
  acceptedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("invitations")
}
